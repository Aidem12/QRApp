<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos Base -->
    <style name="QRAsist" />
    <style name="QRAsist.Text" parent="android:Widget.TextView" />
    <style name="QRAsist.Card" parent="Widget.Material3.CardView.Elevated" />
    <style name="QRAsist.Button" parent="Widget.Material3.Button" />
    <style name="QRAsist.Chip" parent="Widget.Material3.Chip.Assist" />

    <!-- Estilo específico para Chips en Items -->
    <style name="QRAsist.Chip.Item" parent="Widget.Material3.Chip.Assist">
        <item name="android:textColor">@android:color/white</item>
        <item name="chipBackgroundColor">@color/maestro_primary_light</item>
    </style>

    <!-- Toolbar -->
    <style name="QRAsist.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_height">@dimen/toolbar_height</item>
        <item name="titleTextColor">#FFFFFF</item>
        <item name="background">?attr/colorPrimary</item>
    </style>

    <!-- Cards de Estadísticas -->
    <style name="QRAsist.Card.Stats" parent="QRAsist.Card">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_margin">@dimen/spacing_sm</item>
        <item name="contentPaddingTop">20dp</item>
        <item name="contentPaddingBottom">20dp</item>
    </style>

    <!-- Botones -->
    <style name="QRAsist.Button.Primary" parent="QRAsist.Button">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="QRAsist.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_radius</item>
    </style>

    <!-- Inputs -->
    <style name="QRAsist.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>

    <!-- Chips de estado -->
    <style name="QRAsist.Chip.Presente" parent="QRAsist.Chip">
        <item name="chipBackgroundColor">@color/estado_presente</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="QRAsist.Chip.Ausente" parent="QRAsist.Chip">
        <item name="chipBackgroundColor">@color/estado_ausente</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="QRAsist.Chip.Retardo" parent="QRAsist.Chip">
        <item name="chipBackgroundColor">@color/estado_retardo</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <!-- Textos -->
    <style name="QRAsist.Text.Title" parent="QRAsist.Text">
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="QRAsist.Text.Subtitle" parent="QRAsist.Text">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>
    <style name="QRAsist.Text.Body" parent="QRAsist.Text">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>
    <style name="QRAsist.Text.StatNumber" parent="QRAsist.Text">
        <item name="android:textSize">@dimen/stat_number_size</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAlignment">center</item>
    </style>
    <style name="QRAsist.Text.StatLabel" parent="QRAsist.Text">
        <item name="android:textSize">@dimen/stat_label_size</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>